  "name": "chemosciences_discovery",
  "version": "1.0.0",
  "description": "Independent signal-first chemosciences ontology. No affiliation, journal, species, or modality preference; no automated quality claims.",
  "queries": {
    "taste": "(gustat*[Title/Abstract] OR \"taste bud*\"[Title/Abstract] OR \"taste receptor*\"[Title/Abstract] OR \"taste cell*\"[Title/Abstract] OR \"taste perception\"[Title/Abstract] OR \"taste transduction\"[Title/Abstract] OR \"taste dysfunction\"[Title/Abstract] OR \"taste loss\"[Title/Abstract] OR dysgeusia[Title/Abstract] OR ageusia[Title/Abstract] OR fungiform[Title/Abstract] OR circumvallate[Title/Abstract] OR \"chorda tympani\"[Title/Abstract]) OR (\"taste alteration*\"[Title/Abstract] OR \"taste acceptance\"[Title/Abstract] OR \"taste reactivity\"[Title/Abstract] OR \"conditioned taste aversion\"[Title/Abstract] OR \"conditioned taste avoidance\"[Title/Abstract] OR \"taste sensitivity\"[Title/Abstract] OR \"taste prediction\"[Title/Abstract]) OR ((TAS2R*[Title/Abstract] OR TAS1R*[Title/Abstract] OR T1R1[Title/Abstract] OR T1R2[Title/Abstract] OR T1R3[Title/Abstract]) AND (receptor*[Title/Abstract] OR taste[Title/Abstract] OR gustat*[Title/Abstract]))",
    "smell": "(olfact*[Title/Abstract] OR \"odorant receptor*\"[Title/Abstract] OR \"odor perception\"[Title/Abstract] OR \"odor coding\"[Title/Abstract] OR \"odor discrimination\"[Title/Abstract] OR \"smell loss\"[Title/Abstract] OR anosmia[Title/Abstract] OR hyposmia[Title/Abstract] OR parosmia[Title/Abstract] OR retronasal[Title/Abstract])",
    "chemesthesis": "(chemesthe*[Title/Abstract] OR \"trigeminal chemosens*\"[Title/Abstract] OR \"chemical nociception\"[Title/Abstract] OR \"nasal irritation\"[Title/Abstract] OR \"oral pungency\"[Title/Abstract]) OR ((TRPA1[Title/Abstract] OR TRPV1[Title/Abstract] OR TRPM8[Title/Abstract]) AND (oral[Title/Abstract] OR nasal[Title/Abstract] OR lingual[Title/Abstract] OR trigeminal[Title/Abstract] OR chemosens*[Title/Abstract]))",
    "distributed_sensing": "(\"tuft cell*\"[Title/Abstract] OR \"solitary chemosensory cell*\"[Title/Abstract] OR \"extraoral taste\"[Title/Abstract] OR \"ectopic olfactory receptor*\"[Title/Abstract] OR neuropod*[Title/Abstract]) OR ((\"brush cell*\"[Title/Abstract] OR enteroendocrine[Title/Abstract] OR \"carotid body\"[Title/Abstract] OR \"central chemorece*\"[Title/Abstract]) AND (chemosens*[Title/Abstract] OR chemorece*[Title/Abstract] OR \"nutrient sensing\"[Title/Abstract] OR \"chemical sensing\"[Title/Abstract] OR \"taste receptor*\"[Title/Abstract] OR \"odorant receptor*\"[Title/Abstract]))",
    "integration": "(\"flavor perception\"[Title/Abstract] OR \"flavour perception\"[Title/Abstract] OR taste-odor[Title/Abstract] OR odor-taste[Title/Abstract] OR olfactory-gustatory[Title/Abstract] OR gustatory-olfactory[Title/Abstract] OR \"multisensory flavor\"[Title/Abstract] OR \"multisensory flavour\"[Title/Abstract]) OR ((taste[Title/Abstract] OR gustat*[Title/Abstract]) AND (odor*[Title/Abstract] OR olfact*[Title/Abstract] OR smell[Title/Abstract]) AND (predict*[Title/Abstract] OR integrat*[Title/Abstract] OR crossmodal[Title/Abstract] OR cross-modal[Title/Abstract] OR multisensory[Title/Abstract]))",
    "tissue_bridge": "((\"dental pulp\"[Title/Abstract] OR \"salivary gland\"[Title/Abstract] OR \"oral epithelium\"[Title/Abstract] OR \"lingual epithelium\"[Title/Abstract] OR \"nasal mucosa\"[Title/Abstract]) AND (innervation[Title/Abstract] OR trigeminal[Title/Abstract] OR \"sensory neuron*\"[Title/Abstract] OR neuroepithelial[Title/Abstract] OR neuro-epithelial[Title/Abstract]) AND (regenerat*[Title/Abstract] OR \"stem cell*\"[Title/Abstract] OR progenitor*[Title/Abstract] OR differentiation[Title/Abstract] OR homeostasis[Title/Abstract])) OR ((\"salivary gland\"[Title/Abstract]) AND (organoid*[Title/Abstract]) AND (progenitor*[Title/Abstract] OR pluripotent[Title/Abstract]))",
    "internal_sensing": "(chemosensitiv*[Title/Abstract] OR chemorece*[Title/Abstract]) AND (CO2[Title/Abstract] OR \"carbon dioxide\"[Title/Abstract] OR oxygen[Title/Abstract] OR hypoxia[Title/Abstract] OR pH[Title/Abstract]) AND (neuron*[Title/Abstract] OR glomus[Title/Abstract] OR \"carotid body\"[Title/Abstract] OR ventilat*[Title/Abstract])",
    "orosensory_methods": "(orosens*[Title/Abstract]) OR ((lick*[Title/Abstract]) AND (microstructure[Title/Abstract] OR microstructural[Title/Abstract]) AND (tool*[Title/Abstract] OR software[Title/Abstract] OR analysis[Title/Abstract] OR method*[Title/Abstract]))"
