    "negative_categories": [
        {
            "id": "oncology_only_penalty",
            "label": "Cancer-only or oncology-dominant context",
            "penalty": -12,
            "max_penalty": -20,
            "terms": [
                "cancer",
                "tumor",
                "tumour",
                "carcinoma",
                "glioblastoma",
                "medulloblastoma",
                "osteosarcoma",
                "sarcoma",
                "metastasis",
                "chemoresistance",
                "clinical trial",
                "phase ii",
                "phase iii",
                "inhibitor efficacy"
            ],
            "softening_terms": [
                "stem cell niche",
                "adult stem cell",
                "development",
                "morphogenesis",
                "epithelium",
                "epithelial",
                "lineage",
                "cell fate"
            ],
            "logic_note": "Apply full penalty only when cancer terms are present and developmental/tissue-homeostasis bridge terms are absent. Apply smaller penalty when cancer appears alongside relevant mechanistic tissue biology."
        },
        {
            "id": "clinical_behavioral_penalty",
            "label": "Clinical, behavioral, or perception-only context",
            "penalty": -8,
            "max_penalty": -15,
