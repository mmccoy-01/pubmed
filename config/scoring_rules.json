{
    "ontology_name": "taste_hedgehog_literature_triage",
    "version": "0.1.0",
    "description": "Rule-based scoring ontology for triaging papers related to Hedgehog signaling, Gas1/co-receptors, taste organ biology, epithelial morphogenesis, and developmental-to-adult homeostasis.",
    "score_scale": {
        "recommended_min": -25,
        "recommended_max": 100,
        "interpretation": {
            "80_to_100": "core must-read",
            "60_to_79": "highly relevant",
            "40_to_59": "worth reading or skimming",
            "20_to_39": "peripheral or bridge paper",
            "0_to_19": "low priority",
            "below_0": "likely false positive"
        }
    },
    "field_weights": {
        "title_multiplier": 2.0,
        "abstract_multiplier": 1.0,
        "journal_multiplier": 0.5
    },
    "positive_categories": [
        {
            "id": "core_hedgehog_pathway",
            "label": "Core Hedgehog pathway",
            "weight": 10,
            "max_score": 20,
