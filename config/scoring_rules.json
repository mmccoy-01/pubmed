            ]
        }
    ],
    "interaction_bonus_rules": [
        {
            "id": "core_project_match",
            "label": "Core project match",
            "bonus": 25,
            "requires_any_from_each_category": [
                "core_hedgehog_pathway",
                "taste_lingual_system",
                "development_homeostasis_continuity"
            ]
        },
        {
            "id": "gas1_bridge_match",
            "label": "Gas1/co-receptor bridge match",
            "bonus": 18,
            "requires_terms_any": [
                "gas1",
                "boc",
                "cdon",
                "hhip"
            ],
            "requires_category_any": [
                "epithelial_morphogenesis",
                "development_homeostasis_continuity",
                "bridge_systems"
            ]
        },
        {
            "id": "mechanistic_tissue_logic",
            "label": "Mechanistic tissue logic",
            "bonus": 12,
            "requires_any_from_each_category": [
                "epithelial_morphogenesis",
                "crosstalk_niche_dependency",
                "preferred_methods"
            ]
        },
        {
            "id": "chromatin_signal_interpretation",
            "label": "Chromatin-level signaling interpretation",
            "bonus": 12,
            "requires_any_from_each_category": [
                "core_hedgehog_pathway",
                "transcriptional_regulatory_logic"
            ]
        }
    ],
    "source_modifiers": {
        "pubmed": {
            "bonus": 2,
            "label": "Established indexed literature"
        },
        "biorxiv": {
            "bonus": 3,
            "label": "Emerging biology preprint"
        },
        "arxiv": {
            "bonus": 1,
            "label": "Methods/computational preprint"
        }
    },
    "preprint_promotion_rules": [
        {
            "id": "high_signal_biorxiv_promotion",
            "label": "High-signal bioRxiv promotion",
            "eligible_sources": [
                "biorxiv"
            ],
            "minimum_raw_score": 45,
            "requires_terms_any": [
                "gas1",
                "boc",
                "cdon",
                "hhip",
                "taste",
                "gustatory",
                "lingual",
                "papillae",
                "fungiform",
                "circumvallate"
            ],
            "promotion_bonus": 15,
            "promote_to_editorial_review": true
        },
        {
            "id": "methods_arxiv_promotion",
            "label": "Methods/tool arXiv promotion",
            "eligible_sources": [
                "arxiv"
            ],
            "minimum_raw_score": 35,
            "requires_terms_any": [
                "single-cell",
                "scrna-seq",
                "atac-seq",
                "spatial",
                "lineage",
                "segmentation",
                "3d",
                "imaging",
                "morphogenesis"
